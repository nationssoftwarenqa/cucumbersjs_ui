{
  "name": "cucumberjs_api",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "local": "cross-env NODE_ENV=local cucumber-js --format html:local_env-report.html features/**.feature",
     "test": "cross-env NODE_ENV=test  cucumber-js --format html:tes-env-report.html   features/**.feature",
    "stage": "cross-env NODE_ENV=stage cucumber-js --format html:stage-env-report.html features/**.feature",
     "prod": "cross-env NODE_ENV=prod  cucumber-js --format html:prod-env-report.html  features/**.feature"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@cucumber/cucumber": "^11.2.0",
    "@cucumber/pretty-formatter": "^1.0.1",
    "cross-env": "^7.0.3",
    "custom-env": "^2.0.6",
    "dotenv": "^16.5.0",
    "selenium-webdriver": "^4.27.0",
    "xpath": "^0.0.34"
  },
  "devDependencies": {
    "cucumber-html-reporter": "^7.2.0"
  }
}
